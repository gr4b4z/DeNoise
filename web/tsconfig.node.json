{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client", "@testing-library/jest-dom"],
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**/*.ts"]
}
